{
  "name": "@quireos/store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QuireOS store service: accounts, listings, hosted bundles and device pairing (Cloudflare Worker)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply quireos-store --local",
    "migrate:remote": "wrangler d1 migrations apply quireos-store --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.30.0"
  }
}
