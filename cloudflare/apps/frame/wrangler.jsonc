{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "quireos-app-frame",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // satori + resvg render a 540×960 card in 100–400 ms of CPU: this needs Workers Paid
  // (the Free plan's 10 ms CPU limit will not do). Cards are cached per seed in the Cache API.
  "limits": { "cpu_ms": 5000 },
  // Roboto TTFs are imported as bytes (firmware/fonts); *.wasm is a CompiledWasm module by default.
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  "vars": {
    // "1" validates every screen on every request; `npm run dev` passes --var DEV:1.
    "DEV": "0"
  },
  "observability": { "enabled": true }
}
