{
  "spec_version": 1,
  "description": "Conformance cases for §3 templates, conditions and conditional values. Each case has one of `template` (→ evaluate), `cond` (→ evaluateCond) or `value` (→ resolveValue) and an `expect`. `ctx` at the top level applies unless the case carries its own `ctx` (full replacement). Time zone comes from ctx.device.tz (UTC when absent).",
  "ctx": {
    "device": {
      "time": 1758441600,
      "tz": "Australia/Sydney",
      "battery": 73,
      "charging": false,
      "rssi": -61,
      "name": "Kitchen",
      "online": true,
      "w": 540,
      "h": 960,
      "greys": 16,
      "dpi": 235
    },
    "settings": {
      "ha_url": "http://homeassistant.local:8123",
      "ha_token": "secret-token",
      "units": "C",
      "count": 3,
      "dark": false,
      "entities": [
        {
          "id": "switch.pool",
          "label": "Pool"
        },
        {
          "id": "light.deck",
          "label": "Deck"
        }
      ]
    },
    "vars": {
      "pool": "on",
      "page": "2",
      "empty": "",
      "zero": "0",
      "off": "off",
      "f": "false",
      "n": 0,
      "b": false,
      "t": true,
      "temp": 21.456,
      "big": 12345.6789,
      "neg": -3.5,
      "str": "Hello World",
      "mixed": "MiXeD 123 ÄÖ",
      "when": "2026-07-04T14:05:00",
      "date": "2026-02-28",
      "isoz": "2026-03-15T09:30:00-07:00",
      "epochStr": "1767225600",
      "frac": 1758441600.9,
      "ten": "10",
      "nine": "9",
      "list": [
        1,
        2
      ],
      "obj": {
        "a": 1
      }
    },
    "data": {
      "e0": {
        "state": "on",
        "attributes": {
          "brightness": 128,
          "friendly_name": "Pool Lights",
          "tags": [
            "a",
            "b"
          ]
        },
        "last_changed": "2025-09-21T08:00:00+00:00"
      },
      "wx": {
        "current": {
          "temperature_2m": 18.3,
          "is_day": 1,
          "time": "2026-06-10T12:00"
        },
        "hourly": {
          "temperature_2m": [
            17.1,
            18.3,
            19.9
          ]
        }
      },
      "arr": [
        {
          "id": "first"
        },
        {
          "id": "second"
        }
      ]
    }
  },
  "cases": [
    {
      "name": "plain text is unchanged",
      "template": "Hello",
      "expect": "Hello"
    },
    {
      "name": "var lookup",
      "template": "{{vars.pool}}",
      "expect": "on"
    },
    {
      "name": "whitespace inside braces is ignored",
      "template": "{{   vars.pool   }}",
      "expect": "on"
    },
    {
      "name": "several templates in one string",
      "template": "Pool is {{vars.pool}}, page {{vars.page}}",
      "expect": "Pool is on, page 2"
    },
    {
      "name": "missing var is empty",
      "template": "[{{vars.nope}}]",
      "expect": "[]"
    },
    {
      "name": "missing nested path is empty",
      "template": "[{{e0.attributes.nope.deeper}}]",
      "expect": "[]"
    },
    {
      "name": "unknown root is empty",
      "template": "[{{nothing.x}}]",
      "expect": "[]"
    },
    {
      "name": "object renders empty",
      "template": "[{{e0.attributes}}]",
      "expect": "[]"
    },
    {
      "name": "array renders empty",
      "template": "[{{e0.attributes.tags}}]",
      "expect": "[]"
    },
    {
      "name": "array index",
      "template": "{{e0.attributes.tags.1}}",
      "expect": "b"
    },
    {
      "name": "array index out of range is empty",
      "template": "[{{e0.attributes.tags.7}}]",
      "expect": "[]"
    },
    {
      "name": "array of objects",
      "template": "{{arr.1.id}}",
      "expect": "second"
    },
    {
      "name": "non-numeric segment on array is empty",
      "template": "[{{arr.first}}]",
      "expect": "[]"
    },
    {
      "name": "list setting row field",
      "template": "{{settings.entities.0.id}} / {{settings.entities.1.label}}",
      "expect": "switch.pool / Deck"
    },
    {
      "name": "integer renders shortest",
      "template": "{{settings.count}}",
      "expect": "3"
    },
    {
      "name": "float renders shortest",
      "template": "{{vars.temp}}",
      "expect": "21.456"
    },
    {
      "name": "negative number",
      "template": "{{vars.neg}}",
      "expect": "-3.5"
    },
    {
      "name": "zero renders as 0",
      "template": "{{vars.n}}",
      "expect": "0"
    },
    {
      "name": "true renders as true",
      "template": "{{vars.t}}",
      "expect": "true"
    },
    {
      "name": "false renders as false",
      "template": "{{settings.dark}}",
      "expect": "false"
    },
    {
      "name": "device fields",
      "template": "{{device.battery}}% {{device.name}} {{device.online}} {{device.w}}x{{device.h}} {{device.greys}}@{{device.dpi}} {{device.rssi}} {{device.charging}}",
      "expect": "73% Kitchen true 540x960 16@235 -61 false"
    },
    {
      "name": "device.tz and device.time",
      "template": "{{device.tz}} {{device.time}}",
      "expect": "Australia/Sydney 1758441600"
    },
    {
      "name": "data float and nested array",
      "template": "{{wx.current.temperature_2m}}° / {{wx.hourly.temperature_2m.2}}",
      "expect": "18.3° / 19.9"
    },
    {
      "name": "unclosed braces are literal text",
      "template": "{{vars.pool",
      "expect": "{{vars.pool"
    },
    {
      "name": "single braces are literal text",
      "template": "{vars.pool}",
      "expect": "{vars.pool}"
    },
    {
      "name": "empty expression renders empty",
      "template": "[{{}}]",
      "expect": "[]"
    },
    {
      "name": "malformed path renders empty",
      "template": "[{{vars..x}}]",
      "expect": "[]"
    },
    {
      "name": "unknown filter renders empty",
      "template": "[{{vars.pool | nope}}]",
      "expect": "[]"
    },
    {
      "name": "path root alone (object) renders empty",
      "template": "[{{vars}}]",
      "expect": "[]"
    },
    {
      "name": "fixed:1",
      "template": "{{vars.temp | fixed:1}}",
      "expect": "21.5"
    },
    {
      "name": "fixed:0",
      "template": "{{vars.temp | fixed:0}}",
      "expect": "21"
    },
    {
      "name": "fixed pads integers",
      "template": "{{settings.count | fixed:2}}",
      "expect": "3.00"
    },
    {
      "name": "fixed passes non-numbers through",
      "template": "{{vars.str | fixed:1}}",
      "expect": "Hello World"
    },
    {
      "name": "fixed applies to numeric strings",
      "template": "{{vars.epochStr | fixed:1}}",
      "expect": "1767225600.0"
    },
    {
      "name": "fixed on empty is empty",
      "template": "[{{vars.empty | fixed:2}}]",
      "expect": "[]"
    },
    {
      "name": "fixed on negative",
      "template": "{{vars.neg | fixed:2}}",
      "expect": "-3.50"
    },
    {
      "name": "fixed rounds",
      "template": "{{vars.big | fixed:3}}",
      "expect": "12345.679"
    },
    {
      "name": "fixed on boolean passes through",
      "template": "{{vars.t | fixed:1}}",
      "expect": "true"
    },
    {
      "name": "default on empty string",
      "template": "{{vars.empty | default:'n/a'}}",
      "expect": "n/a"
    },
    {
      "name": "default on missing",
      "template": "{{vars.nope | default:'-'}}",
      "expect": "-"
    },
    {
      "name": "default not applied when set",
      "template": "{{vars.pool | default:'x'}}",
      "expect": "on"
    },
    {
      "name": "default not applied to \"0\"",
      "template": "{{vars.zero | default:'x'}}",
      "expect": "0"
    },
    {
      "name": "default not applied to 0",
      "template": "{{vars.n | default:'x'}}",
      "expect": "0"
    },
    {
      "name": "default not applied to false",
      "template": "{{vars.b | default:'x'}}",
      "expect": "false"
    },
    {
      "name": "default with bare word",
      "template": "{{vars.nope | default:none}}",
      "expect": "none"
    },
    {
      "name": "default with number",
      "template": "{{vars.nope | default:5}}",
      "expect": "5"
    },
    {
      "name": "default with quoted spaces",
      "template": "{{vars.nope | default:'no data yet'}}",
      "expect": "no data yet"
    },
    {
      "name": "default applies to objects",
      "template": "{{e0.attributes | default:'obj'}}",
      "expect": "obj"
    },
    {
      "name": "filters chain left to right",
      "template": "{{vars.nope | default:'abc' | upper}}",
      "expect": "ABC"
    },
    {
      "name": "empty quoted default",
      "template": "[{{vars.nope | default:''}}]",
      "expect": "[]"
    },
    {
      "name": "upper",
      "template": "{{vars.str | upper}}",
      "expect": "HELLO WORLD"
    },
    {
      "name": "lower",
      "template": "{{vars.str | lower}}",
      "expect": "hello world"
    },
    {
      "name": "upper is ASCII only",
      "template": "{{vars.mixed | upper}}",
      "expect": "MIXED 123 ÄÖ"
    },
    {
      "name": "lower is ASCII only",
      "template": "{{vars.mixed | lower}}",
      "expect": "mixed 123 ÄÖ"
    },
    {
      "name": "upper on number",
      "template": "{{vars.temp | upper}}",
      "expect": "21.456"
    },
    {
      "name": "upper on boolean",
      "template": "{{vars.t | upper}}",
      "expect": "TRUE"
    },
    {
      "name": "time HH:mm",
      "template": "{{device.time | time:'HH:mm'}}",
      "expect": "18:00"
    },
    {
      "name": "time h:mm a",
      "template": "{{device.time | time:'h:mm a'}}",
      "expect": "6:00 pm"
    },
    {
      "name": "time long date",
      "template": "{{device.time | time:'EEEE d MMMM yyyy'}}",
      "expect": "Sunday 21 September 2025"
    },
    {
      "name": "time short date",
      "template": "{{device.time | time:'EEE dd MMM'}}",
      "expect": "Sun 21 Sep"
    },
    {
      "name": "time ISO date",
      "template": "{{device.time | time:'yyyy-MM-dd'}}",
      "expect": "2025-09-21"
    },
    {
      "name": "time single tokens",
      "template": "{{device.time | time:'H'}}|{{device.time | time:'M'}}|{{device.time | time:'MM'}}|{{device.time | time:'d'}}|{{device.time | time:'hh'}}",
      "expect": "18|9|09|21|06"
    },
    {
      "name": "time literal characters copied",
      "template": "{{device.time | time:'HH:mm on EEE'}}",
      "expect": "18:00 on Sun"
    },
    {
      "name": "time non-token letters copied",
      "template": "{{device.time | time:'H m E yy'}}",
      "expect": "18 m E yy"
    },
    {
      "name": "time epoch as numeric string (AEDT)",
      "template": "{{vars.epochStr | time:'d/M/yyyy HH:mm:ss EEEE'}}",
      "expect": "1/1/2026 11:00:00 Thursday"
    },
    {
      "name": "time ISO with offset",
      "template": "{{vars.isoz | time:'EEE HH:mm'}}",
      "expect": "Mon 03:30"
    },
    {
      "name": "time ISO +00:00",
      "template": "{{e0.last_changed | time:'HH:mm'}}",
      "expect": "18:00"
    },
    {
      "name": "time ISO without zone is local",
      "template": "{{vars.when | time:'h:mm a EEE'}}",
      "expect": "2:05 pm Sat"
    },
    {
      "name": "time ISO date only",
      "template": "{{vars.date | time:'EEEE d MMMM yyyy HH:mm'}}",
      "expect": "Saturday 28 February 2026 00:00"
    },
    {
      "name": "time ISO without seconds",
      "template": "{{wx.current.time | time:'HH:mm'}}",
      "expect": "12:00"
    },
    {
      "name": "time fractional epoch floors",
      "template": "{{vars.frac | time:'HH:mm:ss'}}",
      "expect": "18:00:00"
    },
    {
      "name": "time passes non-times through",
      "template": "{{vars.str | time:'HH'}}",
      "expect": "Hello World"
    },
    {
      "name": "time on empty then default",
