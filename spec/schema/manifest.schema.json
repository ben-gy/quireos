{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quireos.org/spec/1/manifest.schema.json",
  "title": "QuireOS app manifest (spec_version 1, §5)",
  "type": "object",
  "required": [
    "spec_version",
    "id",
    "name",
    "version",
    "min_os",
    "icon",
    "entry"
  ],
  "properties": {
    "spec_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "min_os": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "icon": {
      "type": "string",
      "pattern": "^([a-z0-9][a-z0-9_-]{0,63}|https?://.+|/.+)$"
    },
    "orientation": {
      "type": "string",
      "enum": [
        "portrait",
        "landscape"
      ]
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[1-9]\\d{1,4}x[1-9]\\d{1,4}$"
      }
    },
    "entry": {
      "type": "string",
      "pattern": "^(https?://[^/?#\\s]+.*|/[^/].*|/)$"
    },
    "event": {
      "type": "string",
      "pattern": "^(https?://[^/?#\\s]+.*|/[^/].*|/)$"
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(https?://[a-z0-9.-]+(:\\d{1,5})?|\\{\\{\\s*settings\\.[a-z][a-z0-9_-]{0,31}\\s*\\}\\})$"
      }
    },
    "settings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/setting"
      }
    }
  },
  "$defs": {
    "setting": {
      "anyOf": [
        {
          "$ref": "#/$defs/scalar_setting"
        },
        {
          "$ref": "#/$defs/list_setting"
        }
      ]
    },
    "scalar_setting": {
      "type": "object",
      "required": [
        "key",
        "label",
        "type"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "help": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "secret",
            "url",
            "number",
            "bool",
            "select"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "string"
            },
            "default": {
              "type": "string"
            },
            "options": false
          }
        },
        {
          "properties": {
            "type": {
              "const": "secret"
            },
            "default": false
          }
        },
        {
          "properties": {
            "type": {
              "const": "url"
            },
            "default": {
              "type": "string",
              "pattern": "^https?://"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "number"
            },
            "default": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "bool"
            },
            "default": {
              "type": "boolean"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "select"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "value",
                  "label"
                ],
                "properties": {
                  "value": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            },
            "default": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "required": [
            "options"
          ]
        }
      ]
    },
    "list_setting": {
      "type": "object",
      "required": [
        "key",
        "label",
        "type",
        "item"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "help": {
          "type": "string"
        },
        "type": {
          "const": "list"
        },
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "item": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scalar_setting"
          }
        },
        "default": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
