{
  "spec_version": 1,
  "id": "lanapp",
  "name": "LAN Switch",
  "version": "1.0.0",
  "min_os": "0.1.0",
  "icon": "lightbulb",
  "orientation": "portrait",
  "entry": "/screens/home.json",
  "hosts": ["{{settings.ha_url}}"],
  "settings": [
    { "key": "ha_url", "label": "Home Assistant URL", "type": "url", "required": true, "default": "http://127.0.0.1:8123" },
    { "key": "ha_token", "label": "Long-lived access token", "type": "secret", "required": true },
    { "key": "label", "label": "Tile label", "type": "string", "default": "Pool Lights" }
  ]
}
